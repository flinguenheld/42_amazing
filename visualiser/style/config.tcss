# Theme colours:
#   - primary
#   - secondary
#   - accent
#   - foreground
#   - background
#   - success
#   - warning
#   - error
#   - surface
#   - panel

TOptions {
    align: center middle;
}

#layout_options {
    width: 100;
    height: 50;
    border: thick $primary;
    background: $surface;
    padding: 1 3 1 3;
}

.option_field_layout {
    width: 80;
    height: 4;
    margin: 0;
    padding: 0;
    content-align: center middle;
}

.option_label {
    height: 3;
    margin: 0;
    padding: 0;
    width: 30;
    align: left middle;
    border: round transparent;
}

.option_inputs {
    width: 90;
    height: 3;

    padding: 0;
    margin: 0;
    content-align: center middle;
}

.option_input_str {
    height: 3;
    width: 50;
}

# .option_select_ratio {
#     width: 60;
# }

# .option_select_coordinate_algo {
#     width: auto;
#     content-align: center middle;
# }

.option_checkbox {
    height: 3;
    margin: 0;
    padding: 0;
    width: 50;
    content-align: center middle;
    # border: round transparent;
}

# # ############################################################
# # ############################################### BUTTONS ####
#option_button_layout {
    margin: 1 0 0 0;
    align: center middle;
}

.option_button {
    width: 20;
    margin: 0 1;
}
